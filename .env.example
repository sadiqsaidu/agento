# Solana RPC endpoint (devnet for testing)
SOLANA_RPC_URL=https://api.devnet.solana.com

# REST server port
REST_PORT=3000

# Directory for encrypted wallet keystores
KEYSTORE_DIR=./wallets

# Jupiter API key (optional — free tier at https://portal.jup.ag)
JUPITER_API_KEY=

# For demo agents (get a key at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
