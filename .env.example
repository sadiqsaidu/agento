# Solana RPC endpoint (devnet for testing)
SOLANA_RPC_URL=https://api.devnet.solana.com

# OpenRouter API key (for the demo agent's LLM)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Jupiter API key (free tier: 1 RPS — get at https://portal.jup.ag)
# Optional: price fetching falls back to DexScreener if not set
JUPITER_API_KEY=

# REST server port (default: 3000)
REST_PORT=3000

# Directory for encrypted wallet keystores (default: ./wallets)
KEYSTORE_DIR=./wallets

# Wallet credentials (used by MCP server and demo agent)
WALLET_ID=
WALLET_PASSWORD=agento
